<Window x:Class="WindowsChangeJournal.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="监控设置" Icon="Assets/app-icon.ico" Height="760" Width="820" MinHeight="650" MinWidth="720"
        WindowStartupLocation="CenterOwner" ResizeMode="CanResizeWithGrip" Background="#F4F7FB">
  <Grid Margin="20">
    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
    <StackPanel Grid.Row="0" Margin="0,0,0,16">
      <TextBlock Text="监控设置" FontSize="24" FontWeight="SemiBold" Foreground="#172033"/>
      <TextBlock Text="默认全局记录可用固定磁盘；排除规则会在任何事件写入数据库前生效。" Foreground="#64748B" Margin="0,5,0,0"/>
    </StackPanel>

    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
      <StackPanel>
        <GroupBox Header="监控目录">
          <Grid>
            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="150"/></Grid.RowDefinitions>
            <StackPanel Grid.Row="0" Margin="4,0,4,12">
              <CheckBox x:Name="GlobalModeBox" Content="全局记录：自动监控所有可用固定磁盘" FontWeight="SemiBold"/>
              <TextBlock Text="全局模式采用实时监听，不会在启动时扫描整盘；下方目录可用于关闭全局模式后的自定义范围，或补充网络位置。" Foreground="#64748B" TextWrapping="Wrap" Margin="24,6,0,0"/>
            </StackPanel>
            <WrapPanel Grid.Row="1" Margin="-4,0,0,8">
              <Button Content="添加目录…" Click="AddWatch_Click"/>
              <Button Content="添加桌面" Click="AddDesktop_Click"/>
              <Button Content="添加文档" Click="AddDocuments_Click"/>
              <Button Content="添加下载" Click="AddDownloads_Click"/>
              <Button Content="移除所选" Click="RemoveWatch_Click"/>
            </WrapPanel>
            <ListBox x:Name="WatchList" Grid.Row="2" BorderBrush="#D8E0EC"/>
          </Grid>
        </GroupBox>

        <GroupBox Header="事件来源">
          <StackPanel>
            <CheckBox x:Name="SystemEventsBox" Content="记录 Windows 系统后台文件变化" Margin="6,6"/>
            <CheckBox x:Name="DefenderEventsBox" Content="记录 Microsoft Defender 防病毒隔离/保护历史记录相关变化" Margin="6,6"/>
            <TextBlock Text="两个开关相互独立，默认均关闭，只影响保存后的新事件；已有记录不会自动删除。普通事件按路径推定为用户或软件操作，不能证明实际写入进程。" Foreground="#64748B" TextWrapping="Wrap" Margin="6,5,6,2"/>
          </StackPanel>
        </GroupBox>

        <GroupBox Header="私密和降噪排除目录">
          <Grid>
            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="115"/></Grid.RowDefinitions>
            <WrapPanel Grid.Row="0" Margin="-4,0,0,8"><Button Content="添加排除目录…" Click="AddExclude_Click"/><Button Content="移除所选" Click="RemoveExclude_Click"/></WrapPanel>
            <ListBox x:Name="ExcludeList" Grid.Row="1" BorderBrush="#E3E8EF"/>
          </Grid>
        </GroupBox>

        <GroupBox Header="游戏和应用暂停">
          <Grid>
            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="230"/></Grid.ColumnDefinitions>
            <StackPanel Grid.Column="0">
              <TextBlock Text="每行一个进程名，例如 Game.exe 或 Game" Foreground="#667085" Margin="4,0,0,4"/>
              <TextBox x:Name="ProcessBox" Height="110" AcceptsReturn="True" VerticalScrollBarVisibility="Auto"/>
            </StackPanel>
            <StackPanel Grid.Column="1" Margin="18,0,0,0">
              <TextBlock Text="暂停条件" Foreground="#667085" Margin="4,0,0,4"/>
              <ComboBox x:Name="ProcessModeBox" SelectedIndex="0"><ComboBoxItem Content="该应用位于前台"/><ComboBoxItem Content="该应用正在运行"/></ComboBox>
              <TextBlock Text="恢复前会等待 3 秒稳定时间。暂停期间的变化不会补录。" Foreground="#667085" TextWrapping="Wrap" Margin="4,8,4,0"/>
            </StackPanel>
          </Grid>
        </GroupBox>

        <GroupBox Header="采集和存储">
          <Grid>
            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
            <WrapPanel Grid.Row="0">
              <CheckBox x:Name="RecursiveBox" Content="监控子目录（不跟随目录联接）" Margin="6,8"/>
              <CheckBox x:Name="ContentChangesBox" Content="记录并合并文件修改事件" Margin="20,8,6,8"/>
            </WrapPanel>
            <Grid Grid.Row="1" Margin="0,8,0,0">
              <Grid.ColumnDefinitions><ColumnDefinition Width="170"/><ColumnDefinition Width="150"/><ColumnDefinition Width="170"/><ColumnDefinition Width="150"/></Grid.ColumnDefinitions>
              <TextBlock Grid.Column="0" Text="历史保留天数" VerticalAlignment="Center" Margin="6"/>
              <TextBox x:Name="RetentionBox" Grid.Column="1"/>
              <TextBlock Grid.Column="2" Text="数据空间上限 MB" VerticalAlignment="Center" Margin="16,6,6,6"/>
              <TextBox x:Name="StorageBox" Grid.Column="3"/>
            </Grid>
            <WrapPanel Grid.Row="2" Margin="0,8,0,0">
              <CheckBox x:Name="StartupBox" Content="登录 Windows 后自动启动" Margin="6,8"/>
              <CheckBox x:Name="TrayBox" Content="关闭主窗口时保留托盘记录器" Margin="20,8,6,8"/>
            </WrapPanel>
          </Grid>
        </GroupBox>

        <GroupBox Header="设置文件">
          <DockPanel>
            <TextBlock Text="可导入或导出 JSON 设置；导入不会立即覆盖现有文件，点击保存后才生效。" Foreground="#667085" VerticalAlignment="Center" TextWrapping="Wrap"/>
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal"><Button Content="导入…" Click="Import_Click"/><Button Content="导出…" Click="Export_Click"/></StackPanel>
          </DockPanel>
        </GroupBox>
      </StackPanel>
    </ScrollViewer>

    <DockPanel Grid.Row="2" Margin="0,14,0,0">
      <TextBlock Text="数据库位于当前用户的本地应用数据目录。" Foreground="#667085" VerticalAlignment="Center"/>
      <StackPanel DockPanel.Dock="Right" Orientation="Horizontal"><Button Content="取消" IsCancel="True"/><Button Content="保存" Style="{StaticResource PrimaryButton}" Click="Save_Click" IsDefault="True"/></StackPanel>
    </DockPanel>
  </Grid>
</Window>
